{
  "name": "pbs-desk",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "demo-data": "cd .. && python3 -m pbs.cli demo --out web/public/demo",
    "gen:types": "json2ts -i src/types/contracts.schema.json -o src/types/contracts.ts --unreachableDefinitions --ignoreMinAndMaxItems --additionalProperties false --bannerComment \"/* Generated from pbs/contracts.py by 'npm run gen:types'. Do not edit. */\""
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "json-schema-to-typescript": "^16.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
